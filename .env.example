# 观意配置：启动时自动复制为 .env，平时只修改 .env。
# 无需 API 也能运行：保持默认 rule 即可。修改后重启程序。
# ===== 接 AI 时只需要修改以下四项 =====
# 接口类型：rule=不接 AI；openai=OpenAI 兼容接口；deepseek=DeepSeek 官方。
PROVIDER=rule
# 模型名称：填写服务商提供的模型 ID，不是自己起的名称。
MODEL=
# 接口基础地址：填写服务商提供的 Base URL（例如 https://api.example.com/v1）。
# 不要在末尾添加 /chat/completions。
MODEL_BASE_URL=
# 服务商给你的 API 密钥。不要把填好密钥的 .env 上传 GitHub。
MODEL_API_KEY=
# DeepSeek 官方：PROVIDER=deepseek，MODEL 填账户支持的型号，
# MODEL_BASE_URL=https://api.deepseek.com，MODEL_API_KEY 填自己的密钥。

# ===== 高级配置：第一次使用全部不用改 =====
# 项目数据和图表的保存目录。
WORKBENCH_DATA=./data
# 单个上传文件大小上限，单位 MB。
MAX_UPLOAD_MB=50
# 导入数据的最大行数。
MAX_ROWS=1000000
# 每个计算任务最多运行多少秒。
RUN_TIMEOUT=120
# 每个后台任务内存限制，单位 MB。
RUN_MAX_MB=3072
# 数据库连接；只上传 Excel/CSV 时保持 {}。
DB_SOURCES_JSON={}
# 本机 SQLite 文件白名单；不用 SQLite 时保持 {}。
SQLITE_FILES_JSON={}
